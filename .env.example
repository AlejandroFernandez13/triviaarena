# Local development: use a PostgreSQL database and paste its connection string here.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/trivia_arena
SESSION_SECRET=replace-this-with-a-long-random-secret
NODE_ENV=development
PORT=3000

# Optional. Without this, the game uses a built-in question bank and local answer matching.
# OpenAI API usage may incur separate charges. Never commit a real key to GitHub.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
